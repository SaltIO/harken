# Harken configuration — all optional. Copy to .env and edit as needed.
# Harken runs with ZERO configuration; everything below is an upgrade, not a requirement.

# --- Storage ---
# HARKEN_DB=harken.db

# --- Observability ---
# Console is human-readable; json emits one structured object per application event.
# HARKEN_LOG_FORMAT=console
# HARKEN_LOG_LEVEL=INFO

# --- Sources ---
# Comma-separated. Zero-config defaults: hackernews,bluesky
# Other options: stackoverflow, reddit, mastodon, rss, x, youtube
# HARKEN_SOURCES=hackernews,bluesky
# HARKEN_LIMIT=50
# Retry network errors, HTTP 429, and HTTP 5xx with exponential backoff
# HARKEN_RETRIES=2
# HARKEN_RETRY_BACKOFF=1.0

# Reddit: current Data API access requires OAuth credentials or a bearer token
# HARKEN_REDDIT_CLIENT_ID=
# HARKEN_REDDIT_CLIENT_SECRET=
# HARKEN_REDDIT_ACCESS_TOKEN=

# X recent search: requires an X developer plan with API v2 search access
# HARKEN_X_BEARER_TOKEN=

# YouTube video search: enable YouTube Data API v3 and create an API key
# HARKEN_YOUTUBE_API_KEY=

# Mastodon: full-text status search normally requires a user access token
# HARKEN_MASTODON_INSTANCE=mastodon.social
# HARKEN_MASTODON_ACCESS_TOKEN=

# RSS: comma-separated feed URLs (e.g. a Google Alerts RSS, a blog, a news feed)
# HARKEN_RSS_FEEDS=https://example.com/feed.xml,https://news.example/rss
# Optional descriptive HTTP User-Agent with an operator contact URL/email.
# HARKEN_USER_AGENT=my-listener/1.0 (+https://example.com/contact)

# --- Alerts ---
# Generic HTTP webhook or Slack incoming webhook. Only newly ingested negative
# mentions are queued; failed deliveries are retried on the next scan.
# Keep this secret: Slack webhook URLs contain credentials.
# HARKEN_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional SMTP delivery to one or more comma-separated recipients. The three
# core values must be configured together. Authentication is optional, but the
# username/password pair must be set together when used.
# HARKEN_EMAIL_TO=ops@example.com,owner@example.com
# HARKEN_EMAIL_FROM=harken@example.com
# HARKEN_SMTP_HOST=smtp.example.com
# HARKEN_SMTP_PORT=587
# Security: starttls (default) | ssl | none (trusted local relay only)
# HARKEN_SMTP_SECURITY=starttls
# HARKEN_SMTP_USERNAME=
# HARKEN_SMTP_PASSWORD=

# Optional rolling threshold alerts through every configured transport. Both thresholds
# default to 0 (disabled), so enabling a webhook alone preserves mention-only
# behavior. The baseline is the preceding N complete windows.
# HARKEN_ALERT_WINDOW_HOURS=24
# HARKEN_ALERT_BASELINE_WINDOWS=7
# HARKEN_ALERT_MIN_MENTIONS=5
# Alert when current volume is this many times the preceding-window average.
# HARKEN_ALERT_VOLUME_MULTIPLIER=2.0
# Alert when net sentiment drops by this fraction versus the baseline (0.25 = 25%).
# HARKEN_ALERT_SENTIMENT_DROP=0.25
# Re-arm a recovered event only after this many hours (0 disables cooldown).
# HARKEN_ALERT_COOLDOWN_HOURS=24

# --- Optional dashboard authentication ---
# Account mode: first run `harken user create admin` against this same HARKEN_DB.
# Viewer is read-only; operator/admin can scan and manage project groupings.
# HARKEN_AUTH_MODE=accounts
# HARKEN_SESSION_HOURS=12
# Set true only when the dashboard is reached through HTTPS.
# HARKEN_SESSION_SECURE=false

# Backward-compatible single-user Basic mode. Setting both credentials infers
# basic mode when HARKEN_AUTH_MODE is omitted. Always protect Basic auth with HTTPS.
# HARKEN_AUTH_USERNAME=harken
# HARKEN_AUTH_PASSWORD=replace-with-a-long-random-secret

# --- Optional LLM (for nicer theme labels). Local lexicon analysis is the default. ---
# Provider: none (default) | anthropic | openai | ollama
# HARKEN_LLM_PROVIDER=none
# HARKEN_LLM_MODEL=
# Sentiment stays on the measured local lexicon unless explicitly opted in.
# LLM mode sends up to 1,000 characters from every fetched mention to the provider,
# validates batched JSON responses, and falls back locally on any provider error.
# HARKEN_SENTIMENT_ANALYZER=lexicon

# Anthropic (pip install anthropic)
# HARKEN_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# HARKEN_LLM_MODEL=claude-opus-4-8

# OpenAI-compatible (OpenAI, OpenRouter, Together, …)
# HARKEN_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# HARKEN_LLM_BASE_URL=https://api.openai.com/v1
# HARKEN_LLM_MODEL=gpt-4o-mini

# Ollama (theme-label analysis stays on your machine)
# HARKEN_LLM_PROVIDER=ollama
# HARKEN_LLM_HOST=http://localhost:11434
# HARKEN_LLM_MODEL=llama3.2
